<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. Set to Light by default. -->
    <style name="Theme.BeaconSOS" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorPrimaryVariant">@color/primary_dark_blue</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <!-- Surfaces & Backgrounds -->
        <item name="android:windowBackground">@color/background_color</item>
        <item name="colorSurface">@color/surface_color</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Text Colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>

        <!-- Custom Attributes -->
        <item name="dividerHorizontal">@color/divider_color</item>

        <!-- Explicitly disable the default Action Bar -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <!-- Popup Menu Styles for Glassy Effect -->
        <item name="android:popupMenuStyle">@style/GlassyPopupMenu</item>
        <item name="popupMenuStyle">@style/GlassyPopupMenu</item>
    </style>

    <style name="CircleImage">
        <item name="cornerSize">50%</item>
    </style>

    <style name="GlassyDialog" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

    <style name="GlassyPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/glassy_menu_bg</item>
    </style>

    <!-- Dedicated theme for the PopupMenu wrapper -->
    <style name="GlassyPopupTheme" parent="Theme.MaterialComponents.Light">
        <item name="android:popupMenuStyle">@style/GlassyPopupMenu</item>
        <item name="popupMenuStyle">@style/GlassyPopupMenu</item>
        <item name="android:textColorPrimary">@color/black</item>
    </style>

    <style name="GlassySearchView" parent="Widget.AppCompat.SearchView">
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorHint">#CCFFFFFF</item>
        <item name="queryBackground">@android:color/transparent</item>
        <item name="submitBackground">@android:color/transparent</item>
        <item name="searchIcon">@android:drawable/ic_menu_search</item>
        <item name="closeIcon">@android:drawable/ic_menu_close_clear_cancel</item>
        <item name="voiceIcon">@android:drawable/ic_btn_speak_now</item>
    </style>
</resources>
