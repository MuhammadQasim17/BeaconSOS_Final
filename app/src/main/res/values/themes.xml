<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme using Material 3 -->
    <style name="Theme.BeaconSOS" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Disable M3 elevation surface tinting so cards remain pure white in light mode -->
        <item name="elevationOverlayEnabled">false</item>

        <!-- Primary brand colors (Vibrant Emergency Crimson) -->
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorOnPrimary">@color/color_on_primary</item>
        <item name="colorPrimaryContainer">@color/color_surface</item>
        <item name="colorOnPrimaryContainer">@color/color_on_surface</item>

        <!-- Secondary brand colors -->
        <item name="colorSecondary">@color/color_secondary</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Status & Navigation bar colors & icon contrast -->
        <item name="android:statusBarColor">@color/color_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- Surfaces & Backgrounds -->
        <item name="android:windowBackground">@color/color_background</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorOnSurface">@color/color_on_surface</item>
        <item name="colorSurfaceVariant">@color/color_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/color_on_surface_variant</item>
        <item name="colorOutline">@color/border_color</item>
        <item name="colorError">@color/color_error</item>

        <!-- Typography Defaults -->
        <item name="android:textColorPrimary">@color/color_on_surface</item>
        <item name="android:textColorSecondary">@color/color_on_surface_variant</item>
        <item name="android:textColorHint">@color/text_hint</item>

        <!-- Custom Attributes & Compatibility -->
        <item name="dividerHorizontal">@color/border_color</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <!-- Global Navigation Icon Tint -->
        <item name="navigationIconTint">@color/color_on_surface</item>
        <item name="colorControlNormal">@color/color_on_surface</item>
        <item name="android:homeAsUpIndicator">@drawable/ic_back_white</item>

        <!-- Default Card Appearance Overrides -->
        <item name="cardViewStyle">@style/Widget.BeaconSOS.CardView</item>
        <item name="materialCardViewStyle">@style/Widget.BeaconSOS.CardView</item>

        <!-- Popup Menu Styles -->
        <item name="android:popupMenuStyle">@style/GlassyPopupMenu</item>
        <item name="popupMenuStyle">@style/GlassyPopupMenu</item>
    </style>

    <!-- Material 3 Card Appearance Defaults -->
    <style name="ShapeAppearance.BeaconSOS.Card" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Widget.BeaconSOS.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.BeaconSOS.Card</item>
        <item name="cardBackgroundColor">@color/color_surface</item>
        <item name="strokeColor">@color/border_color</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">2dp</item>
    </style>

    <!-- Material 3 Typography Styles -->
    <style name="TextAppearance.BeaconSOS.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_on_surface</item>
    </style>

    <style name="TextAppearance.BeaconSOS.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_on_surface</item>
    </style>

    <style name="TextAppearance.BeaconSOS.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/color_on_surface</item>
    </style>

    <style name="TextAppearance.BeaconSOS.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/color_on_surface_variant</item>
    </style>

    <!-- Custom View Styles -->
    <style name="CircleImage">
        <item name="cornerSize">50%</item>
    </style>

    <style name="AboutFeatureRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_marginBottom">@dimen/spacing_medium</item>
    </style>

    <style name="AboutFeatureIcon">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:tint">@color/color_primary</item>
    </style>

    <style name="AboutFeatureText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/spacing_medium</item>
        <item name="android:textColor">@color/color_on_surface</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="GlassyDialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="background">@android:color/transparent</item>
    </style>

    <style name="GlassyPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/glassy_menu_bg</item>
    </style>

    <style name="GlassyPopupTheme" parent="Theme.Material3.DayNight">
        <item name="android:popupMenuStyle">@style/GlassyPopupMenu</item>
        <item name="popupMenuStyle">@style/GlassyPopupMenu</item>
        <item name="android:textColorPrimary">@color/color_on_surface</item>
    </style>

    <style name="GlassySearchView" parent="Widget.AppCompat.SearchView">
        <item name="android:textColorPrimary">@color/color_on_surface</item>
        <item name="android:textColorHint">#94A3B8</item>
        <item name="queryBackground">@android:color/transparent</item>
        <item name="submitBackground">@android:color/transparent</item>
        <item name="searchIcon">@android:drawable/ic_menu_search</item>
        <item name="closeIcon">@android:drawable/ic_menu_close_clear_cancel</item>
        <item name="voiceIcon">@android:drawable/ic_btn_speak_now</item>
    </style>
</resources>
