<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/color_background"
    tools:context=".ui.ChangePasswordActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_surface"
        app:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Change Password"
            app:titleCentered="true"
            app:titleTextColor="@color/color_on_surface"
            app:navigationIcon="@drawable/ic_back_white"
            app:navigationIconTint="@color/color_on_surface" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="none"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Clean Single Card Container for Password Inputs with Horizontal Dividers -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/color_surface"
                app:strokeColor="@color/border_color"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Current Password Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_password_new"
                            app:tint="@color/color_primary"
                            android:contentDescription="Password Icon" />

                        <EditText
                            android:id="@+id/etCurrentPassword"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:background="@android:color/transparent"
                            android:hint="Current Password"
                            android:textColor="@color/color_on_surface"
                            android:textColorHint="@color/text_hint"
                            android:textSize="15sp"
                            android:inputType="textPassword" />

                        <ImageView
                            android:id="@+id/ivToggleCurrentPassword"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_visibility_off"
                            app:tint="@color/color_primary"
                            android:padding="2dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Toggle Password" />
                    </LinearLayout>

                    <!-- Horizontal Divider Line 1 -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/border_color" />

                    <!-- New Password Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_password_new"
                            app:tint="@color/color_primary"
                            android:contentDescription="Password Icon" />

                        <EditText
                            android:id="@+id/etNewPassword"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:background="@android:color/transparent"
                            android:hint="New Password"
                            android:textColor="@color/color_on_surface"
                            android:textColorHint="@color/text_hint"
                            android:textSize="15sp"
                            android:inputType="textPassword" />

                        <ImageView
                            android:id="@+id/ivToggleNewPassword"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_visibility_off"
                            app:tint="@color/color_primary"
                            android:padding="2dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Toggle Password" />
                    </LinearLayout>

                    <!-- Horizontal Divider Line 2 -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/border_color" />

                    <!-- Confirm New Password Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_password_new"
                            app:tint="@color/color_primary"
                            android:contentDescription="Password Icon" />

                        <EditText
                            android:id="@+id/etConfirmNewPassword"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:background="@android:color/transparent"
                            android:hint="Confirm New Password"
                            android:textColor="@color/color_on_surface"
                            android:textColorHint="@color/text_hint"
                            android:textSize="15sp"
                            android:inputType="textPassword" />

                        <ImageView
                            android:id="@+id/ivToggleConfirmPassword"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_visibility_off"
                            app:tint="@color/color_primary"
                            android:padding="2dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Toggle Password" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUpdatePassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:text="UPDATE PASSWORD"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/color_primary"
                app:elevation="4dp"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </ScrollView>

    <include
        layout="@layout/layout_app_loading"
        android:id="@+id/customLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
