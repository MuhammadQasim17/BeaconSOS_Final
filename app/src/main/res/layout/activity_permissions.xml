<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/color_background"
    tools:context=".ui.PermissionsActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_surface"
        app:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarPermissions"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="App Permissions"
            app:titleCentered="true"
            app:titleTextColor="@color/color_on_surface"
            app:navigationIcon="@drawable/ic_back_white"
            app:navigationIconTint="@color/color_on_surface" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/btnOpenSettings"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Beacon SOS requires the following permissions to function correctly during emergencies."
                android:textSize="13sp"
                android:textColor="@color/color_on_surface_variant"
                android:layout_marginBottom="20dp" />

            <!-- Microphone Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/color_surface"
                app:strokeColor="@color/border_color"
                app:strokeWidth="1dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">
                    <ImageView
                        android:id="@+id/ivMic"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_perm_mic"
                        android:contentDescription="Microphone Icon"
                        app:tint="@color/color_primary" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/ivMic"
                        android:layout_marginStart="14dp"
                        android:text="Microphone"
                        android:textColor="@color/color_on_surface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swMic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        app:thumbTint="@color/color_primary"
                        app:trackTint="@color/border_color" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/ivMic"
                        android:layout_marginStart="42dp"
                        android:layout_marginTop="4dp"
                        android:text="Used to detect SOS trigger words."
                        android:textColor="@color/color_on_surface_variant"
                        android:textSize="13sp" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Location Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/color_surface"
                app:strokeColor="@color/border_color"
                app:strokeWidth="1dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">
                    <ImageView
                        android:id="@+id/ivLoc"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_perm_location"
                        android:contentDescription="Location Icon"
                        app:tint="@color/color_primary" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/ivLoc"
                        android:layout_marginStart="14dp"
                        android:text="Location"
                        android:textColor="@color/color_on_surface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swLoc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        app:thumbTint="@color/color_primary"
                        app:trackTint="@color/border_color" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/ivLoc"
                        android:layout_marginStart="42dp"
                        android:layout_marginTop="4dp"
                        android:text="Used to send your coordinates to contacts."
                        android:textColor="@color/color_on_surface_variant"
                        android:textSize="13sp" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SMS Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/color_surface"
                app:strokeColor="@color/border_color"
                app:strokeWidth="1dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">
                    <ImageView
                        android:id="@+id/ivSms"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_perm_sms"
                        android:contentDescription="SMS Icon"
                        app:tint="@color/color_primary" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/ivSms"
                        android:layout_marginStart="14dp"
                        android:text="SMS"
                        android:textColor="@color/color_on_surface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swSms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        app:thumbTint="@color/color_primary"
                        app:trackTint="@color/border_color" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/ivSms"
                        android:layout_marginStart="42dp"
                        android:layout_marginTop="4dp"
                        android:text="Used to send automated emergency messages."
                        android:textColor="@color/color_on_surface_variant"
                        android:textSize="13sp" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Camera Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/color_surface"
                app:strokeColor="@color/border_color"
                app:strokeWidth="1dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">
                    <ImageView
                        android:id="@+id/ivCam"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_camera_white"
                        android:contentDescription="Camera Icon"
                        app:tint="@color/color_primary" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/ivCam"
                        android:layout_marginStart="14dp"
                        android:text="Camera"
                        android:textColor="@color/color_on_surface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swCam"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        app:thumbTint="@color/color_primary"
                        app:trackTint="@color/border_color" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/ivCam"
                        android:layout_marginStart="42dp"
                        android:layout_marginTop="4dp"
                        android:text="Used to capture photos for emergency reports."
                        android:textColor="@color/color_on_surface_variant"
                        android:textSize="13sp" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Notifications Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/color_surface"
                app:strokeColor="@color/border_color"
                app:strokeWidth="1dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">
                    <ImageView
                        android:id="@+id/ivNotif"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_perm_notification"
                        android:contentDescription="Notification Icon"
                        app:tint="@color/color_primary" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/ivNotif"
                        android:layout_marginStart="14dp"
                        android:text="Notifications"
                        android:textColor="@color/color_on_surface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swNotif"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        app:thumbTint="@color/color_primary"
                        app:trackTint="@color/border_color" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/ivNotif"
                        android:layout_marginStart="42dp"
                        android:layout_marginTop="4dp"
                        android:text="Used to keep the background service active."
                        android:textColor="@color/color_on_surface_variant"
                        android:textSize="13sp" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenSettings"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_margin="16dp"
        android:text="OPEN SYSTEM SETTINGS"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="@color/color_primary"
        app:cornerRadius="12dp"
        app:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
