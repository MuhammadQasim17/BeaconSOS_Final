<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:importantForAutofill="noExcludeDescendants"
    android:background="@color/color_background"
    tools:context=".ui.SignupActivity">

    <View
        android:id="@+id/viewHeaderBackground"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@drawable/login_header_gradient"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Circular Brand Logo Badge -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardLogoFrame"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="28dp"
        app:cardCornerRadius="36dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/white"
        app:strokeColor="@color/border_color"
        app:strokeWidth="1.5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="Beacon SOS Logo"
            android:src="@mipmap/ic_app_logo"
            app:shapeAppearanceOverlay="@style/CircleImage" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:text="Beacon SOS"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardLogoFrame" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_medium"
        android:fillViewport="true"
        android:importantForAutofill="noExcludeDescendants"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvAppName">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/color_surface"
            app:strokeColor="@color/border_color"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:importantForAutofill="noExcludeDescendants">

                <TextView
                    android:id="@+id/tvSignupTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/create_account"
                    android:textColor="@color/color_on_surface"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/join_network_desc"
                    android:textColor="@color/color_on_surface_variant"
                    android:textSize="14sp" />

                <!-- Full Name Input Field Container -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/outlined_input_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center_vertical|start"
                            android:layout_marginStart="2dp"
                            android:src="@drawable/ic_nav_profile"
                            app:tint="@color/color_primary"
                            android:contentDescription="Name Icon" />
                    </FrameLayout>

                    <EditText
                        android:id="@+id/etFullName"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:background="@android:color/transparent"
                        android:hint="Full Name"
                        android:inputType="textPersonName|textNoSuggestions"
                        android:importantForAutofill="no"
                        android:autofillHints=""
                        android:textColor="@color/color_on_surface"
                        android:textColorHint="@color/text_hint"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- Phone Number Input Field Container -->
                <LinearLayout
                    android:id="@+id/layoutPhoneContainer"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/outlined_input_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="match_parent">

                        <com.hbb20.CountryCodePicker
                            android:id="@+id/ccp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|start"
                            app:ccp_defaultNameCode="PK"
                            app:ccp_showArrow="false"
                            app:ccp_showFlag="true"
                            app:ccp_showNameCode="false"
                            app:ccp_showPhoneCode="false"
                            app:ccp_showFullName="false"
                            app:ccp_textSize="22sp" />
                    </FrameLayout>

                    <EditText
                        android:id="@+id/etPhone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:background="@android:color/transparent"
                        android:hint="Phone Number"
                        android:inputType="phone|textNoSuggestions"
                        android:importantForAutofill="no"
                        android:autofillHints=""
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:textColor="@color/color_on_surface"
                        android:textColorHint="@color/text_hint"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- Password Input Field Container -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/outlined_input_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center_vertical|start"
                            android:layout_marginStart="2dp"
                            android:src="@drawable/ic_lock_security"
                            app:tint="@color/color_primary"
                            android:contentDescription="Password Icon" />
                    </FrameLayout>

                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@android:color/transparent"
                        android:hint="Password"
                        android:inputType="textPassword|textNoSuggestions"
                        android:importantForAutofill="no"
                        android:autofillHints=""
                        android:textColor="@color/color_on_surface"
                        android:textColorHint="@color/text_hint"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/ivTogglePassword"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_visibility_off"
                        app:tint="@color/color_primary"
                        android:padding="2dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Toggle Password" />
                </LinearLayout>

                <!-- Password Rules -->
                <LinearLayout
                    android:id="@+id/layoutRules"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:orientation="vertical">

                    <TextView android:id="@+id/ruleNumber" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✘ Must contain at least one number" android:textColor="@color/color_on_surface_variant" android:textSize="12sp"/>
                    <TextView android:id="@+id/ruleLower" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✘ Must contain at least one lowercase letter" android:textColor="@color/color_on_surface_variant" android:textSize="12sp"/>
                    <TextView android:id="@+id/ruleUpper" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✘ Must contain at least one uppercase letter" android:textColor="@color/color_on_surface_variant" android:textSize="12sp"/>
                    <TextView android:id="@+id/ruleSpecial" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✘ Must contain at least one special character" android:textColor="@color/color_on_surface_variant" android:textSize="12sp"/>
                    <TextView android:id="@+id/ruleLength" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✘ Length must be at least 8 characters" android:textColor="@color/color_on_surface_variant" android:textSize="12sp"/>
                </LinearLayout>

                <!-- Confirm Password Input Field Container -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/outlined_input_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center_vertical|start"
                            android:layout_marginStart="2dp"
                            android:src="@drawable/ic_lock_security"
                            app:tint="@color/color_primary"
                            android:contentDescription="Password Icon" />
                    </FrameLayout>

                    <EditText
                        android:id="@+id/etConfirmPassword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@android:color/transparent"
                        android:hint="Confirm Password"
                        android:inputType="textPassword|textNoSuggestions"
                        android:importantForAutofill="no"
                        android:autofillHints=""
                        android:textColor="@color/color_on_surface"
                        android:textColorHint="@color/text_hint"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/ivToggleConfirmPassword"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_visibility_off"
                        app:tint="@color/color_primary"
                        android:padding="2dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Toggle Password" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvMatchError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="Passwords do not match"
                    android:textColor="@color/color_error"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <!-- High Impact Primary Action Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegister"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="28dp"
                    android:backgroundTint="@color/color_primary"
                    android:text="SIGN UP"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:elevation="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_large"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/already_have_account"
                        android:textColor="@color/color_on_surface_variant"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvGoToLogin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/spacing_xs"
                        android:text="Login"
                        android:textColor="@color/color_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.core.widget.NestedScrollView>

    <!-- Custom Loading Overlay -->
    <include
        android:id="@+id/customLoading"
        layout="@layout/layout_app_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
