<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/vibrant_gradient_bg">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarNewChat"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="Start New Chat"
        app:titleTextColor="@color/white"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarNewChat">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Configure Chat"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Receiver Container (Their Name) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardReceiver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                app:cardBackgroundColor="#33FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="#33FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RECEIVER (CONTACT)"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:alpha="0.8"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Contact Name"
                        android:textColorHint="#B3FFFFFF"
                        app:hintTextColor="@color/white"
                        app:boxStrokeColor="@color/white"
                        app:startIconDrawable="@android:drawable/ic_menu_myplaces"
                        app:startIconTint="@color/white"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNewContactName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName"
                            android:textColor="@color/white"
                            android:autofillHints="name" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#33FFFFFF"
                        app:strokeColor="@color/white"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="4dp">

                            <com.hbb20.CountryCodePicker
                                android:id="@+id/ccpNewContact"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:ccp_showFullName="false"
                                app:ccp_showPhoneCode="true"
                                app:ccp_defaultNameCode="PK"
                                app:ccp_textSize="14sp"
                                app:ccp_contentColor="@color/white" />

                            <EditText
                                android:id="@+id/etNewContactPhone"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@android:color/transparent"
                                android:hint="Phone Number"
                                android:textSize="14sp"
                                android:textColor="@color/white"
                                android:textColorHint="#CCFFFFFF"
                                android:inputType="phone"
                                android:padding="12dp"
                                android:autofillHints="phone" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartChat"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="32dp"
                android:text="START CHAT"
                android:textStyle="bold"
                android:textSize="16sp"
                android:backgroundTint="@color/white"
                android:textColor="#1E88E5"
                app:cornerRadius="30dp"
                app:elevation="0dp" />

        </LinearLayout>
    </ScrollView>

    <include
        layout="@layout/layout_app_loading"
        android:id="@+id/customLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>