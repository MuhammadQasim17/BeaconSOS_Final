<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/color_surface"
    app:strokeColor="@color/border_color"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvHistoryType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MANUAL SOS BUTTON"
                android:textColor="@color/color_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_centerVertical="true" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_alignParentEnd="true"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvHistoryTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Oct 24, 10:30 AM"
                    android:textColor="@color/color_on_surface_variant"
                    android:textSize="12sp"
                    android:layout_marginEnd="6dp" />

                <ImageButton
                    android:id="@+id/btnDeleteHistory"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_delete_new"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/color_primary"
                    android:padding="6dp"
                    android:contentDescription="Delete Event" />
            </LinearLayout>
        </RelativeLayout>

        <TextView
            android:id="@+id/tvHistoryMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Emergency! I need help. My location: [URL]"
            android:textColor="@color/color_on_surface"
            android:textSize="13sp"
            android:autoLink="web"
            android:linksClickable="true"
            android:textColorLink="@color/status_blue"
            android:layout_marginBottom="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_color"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvHistoryContacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sent to: John Doe, Jane Smith"
            android:textColor="@color/color_on_surface_variant"
            android:textSize="12sp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
