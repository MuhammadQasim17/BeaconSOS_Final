<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#26FFFFFF"
    app:strokeColor="#33FFFFFF"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvHistoryType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SHAKE TRIGGER"
                android:textColor="#FFEB3B"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_centerVertical="true" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_alignParentEnd="true"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvHistoryTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Oct 24, 10:30 AM"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp" />

                <ImageButton
                    android:id="@+id/btnDeleteHistory"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_delete"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#B3FFFFFF"
                    android:padding="4dp"
                    android:contentDescription="Delete" />
            </LinearLayout>
        </RelativeLayout>

        <TextView
            android:id="@+id/tvHistoryMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Emergency! I need help. My location: [URL]"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:autoLink="web"
            android:linksClickable="true"
            android:textColorLink="#2196F3"
            android:layout_marginBottom="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1AFFFFFF"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvHistoryContacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sent to: John Doe, Jane Smith"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp"
            android:fontFamily="sans-serif-light" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>